# Copiar a .env y ajustar
DATABASE_URL=postgresql://budgetwise:budgetwise@db:5432/budgetwise
# Para correr sin Docker/PostgreSQL local se puede usar:
# DATABASE_URL=sqlite:///./budgetwise.db
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development

# HU-14 (opcional): con una API key de Anthropic, las recomendaciones se redactan
# con un LLM; sin key, el motor de reglas responde igual con plantillas.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-haiku-4-5
